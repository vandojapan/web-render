+/// Configure geometry/outline-text MSAA before the first user draw.
+pub fn graphics_set_antialiasing(entity: Entity, aa: Antialiasing) -> error::Result<()> {
+    app_mut(|app| smoothing::configure(app, entity, Some(aa), None))
+}
+
+/// Configure image filters per Graphics, preserving each image's wrap modes.
+/// Default inherits the image sampler; explicit values override it.
+pub fn graphics_set_image_sampling(entity: Entity, sampling: ImageSampling) -> error::Result<()> {
+    app_mut(|app| smoothing::configure(app, entity, None, Some(sampling)))
+}
+
+/// Processing-style noSmooth: one raster sample and Nearest image sampling.
+/// Changes after begin_draw, command recording or flush return InvalidArgument.
+pub fn graphics_no_smooth(entity: Entity) -> error::Result<()> {
+    app_mut(|app| {
+        smoothing::configure(
+            app,
+            entity,
+            Some(Antialiasing::Off),
+            Some(ImageSampling::Nearest),
+        )
+    })
+}
+
+/// Read the last completed render without an extra app update/flush.
+/// Call end_draw or graphics_flush first; this does not execute queued commands.
+/// Returns tightly packed rows in the Graphics texture format.
+pub fn graphics_readback_completed_raw(entity: Entity) -> error::Result<graphics::ReadbackData> {
+    app_mut(|app| {
+        let texture = graphics::view_target(app, entity)?.main_texture().clone();
+        app.world_mut()
+            .run_system_cached_with(graphics::readback_raw, (entity, texture))
+            .unwrap()
+    })
+}
+
 /// Read back pixel data from the graphics surface as LinearRgba.
 pub fn graphics_readback(graphics_entity: Entity) -> error::Result<Vec<LinearRgba>> {
     let raw = graphics_readback_raw(graphics_entity)?;
