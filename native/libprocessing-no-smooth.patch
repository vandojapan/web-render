@@ -0,0 +1,20 @@
+/* Call on the initialization thread, after graphics_create and before drawing.
+ * Header is generated by: cargo check -p processing_ffi --release
+ */
+#include "processing.h"
+#include <stdio.h>
+
+int configure_no_smooth(uint64_t graphics) {
+    processing_graphics_no_smooth(graphics);
+    const char *error = processing_check_error();
+    if (error) { fprintf(stderr, "%s\n", error); return 1; }
+    return 0;
+}
+
+int configure_independent_modes(uint64_t graphics) {
+    /* Geometry AA Off, images Linear: independently configurable. */
+    processing_graphics_set_antialiasing(graphics, 1);
+    if (processing_check_error()) return 1;
+    processing_graphics_set_image_sampling(graphics, 1);
+    return processing_check_error() ? 1 : 0;
+}
diff --git a/examples/no_smooth_verify.rs b/examples/no_smooth_verify.rs
new file mode 100644
index 0000000..7ca3636
--- /dev/null
+++ b/examples/no_smooth_verify.rs
@@ -0,0 +1,363 @@
+//! GPU image semantics, isolation, composition and lifecycle verification.
+use bevy::{
+    prelude::*,
+    render::{render_resource::Extent3d, view::Msaa},
+};
+use processing::prelude::*;
+use std::fs;
+
+fn make(w: u32, h: u32, mode: u8) -> error::Result<(Entity, Entity)> {
+    let s = surface_create_offscreen(w, h, 1., TextureFormat::Rgba8UnormSrgb)?;
+    let g = graphics_create(s, w, h, TextureFormat::Rgba8UnormSrgb)?;
+    match mode {
+        1 => graphics_no_smooth(g)?,
+        2 => graphics_set_antialiasing(g, Antialiasing::Off)?,
+        3 => graphics_set_image_sampling(g, ImageSampling::Nearest)?,
+        _ => (),
+    }
+    Ok((s, g))
+}
+fn record(g: Entity, commands: Vec<DrawCommand>) -> error::Result<()> {
+    graphics_begin_draw(g)?;
+    for c in commands {
+        graphics_record_command(g, c)?;
+    }
+    Ok(())
+}
+fn draw_image(image: Entity, w: f32, h: f32) -> DrawCommand {
+    DrawCommand::Image {
+        entity: image,
+        dx: 0.,
+        dy: 0.,
+        d_width: Some(w),
+        d_height: Some(h),
+        sx: None,
+        sy: None,
+        s_width: None,
+        s_height: None,
+    }
+}
+fn read(g: Entity, label: &str, out: &str) -> error::Result<Vec<u8>> {
+    let bytes = graphics_readback_raw(g)?.bytes;
+    fs::write(format!("{out}/{label}.rgba"), &bytes).unwrap();
+    Ok(bytes)
+}
+fn binary(bytes: &[u8]) -> bool {
+    bytes
+        .chunks_exact(4)
+        .all(|p| p == [0, 0, 0, 255] || p == [255, 255, 255, 255])
+}
+fn two_colors(bytes: &[u8]) -> bool {
+    bytes
+        .chunks_exact(4)
+        .all(|p| p == [255, 0, 0, 255] || p == [0, 0, 255, 255])
+}
+fn main() -> error::Result<()> {
+    let out = std::env::args().nth(1).unwrap_or("no-smooth-proof".into());
+    fs::create_dir_all(&out).unwrap();
+    init(Config::default())?;
+    let image = image_create(
+        Extent3d {
+            width: 2,
+            height: 1,
+            depth_or_array_layers: 1,
+        },
+        vec![255, 0, 0, 255, 0, 0, 255, 255],
+        TextureFormat::Rgba8UnormSrgb,
+    )?;
+    // Explicit image Linear must not defeat an explicit Graphics Nearest.
+    image_set_sampler(image, 0, 1, 2)?;
+    let (_, smooth) = make(256, 256, 0)?;
+    let (_, off) = make(256, 256, 1)?;
+    let (_, aa_only) = make(256, 256, 2)?;
+    let (_, sample_only) = make(256, 256, 3)?;
+    for g in [smooth, off, aa_only, sample_only] {
+        record(
+            g,
+            vec![
+                DrawCommand::BackgroundColor(Color::BLACK),
+                DrawCommand::NoStroke,
+                draw_image(image, 256., 256.),
+            ],
+        )?;
+    }
+    assert!(
+        graphics_no_smooth(off).is_err(),
+        "late configuration must error"
+    );
+    let nearest = read(off, "image-nearest", &out)?;
+    let linear = read(smooth, "image-linear", &out)?;
+    assert!(
+        two_colors(&nearest),
+        "nearest must have exactly source colors"
+    );
+    assert!(!two_colors(&linear), "baseline Linear must interpolate");
+    assert!(
+        !two_colors(&read(aa_only, "image-aa-only", &out)?),
+        "AA and sampling must be independent"
+    );
+    assert!(two_colors(&read(sample_only, "image-sampling-only", &out)?));
+    processing_core::app_mut(|app| {
+        let source = app
+            .world()
+            .get::<processing_render::image::Image>(image)
+            .unwrap()
+            .handle
+            .clone();
+        let gpu = app
+            .sub_app(bevy::render::RenderApp)
+            .world()
+            .resource::<bevy::render::render_asset::RenderAssets<bevy::render::texture::GpuImage>>(
+        );
+        let original = gpu.get(&source).unwrap();
+        let aliases: Vec<_> = gpu
+            .iter()
+            .filter(|(id, img)| *id != source.id() && img.texture.id() == original.texture.id())
+            .collect();
+        assert!(
+            aliases.len() >= 2,
+            "Graphics sampler aliases must share the uploaded source texture"
+        );
+        assert!(
+            aliases
+                .iter()
+                .all(|(_, img)| img.sampler.id() != original.sampler.id())
+        );
+        Ok(())
+    })?;
+    let mut repeated = draw_image(image, 256., 256.);
+    if let DrawCommand::Image {
+        sx,
+        sy,
+        s_width,
+        s_height,
+        ..
+    } = &mut repeated
+    {
+        *sx = Some(0.);
+        *sy = Some(0.);
+        *s_height = Some(1.);
+        *s_width = Some(4.);
+    }
+    record(off, vec![DrawCommand::NoStroke, repeated])?;
+    let wrapped = read(off, "image-wrap-repeat", &out)?;
+    for (x, pixel) in [
+        (32, [255, 0, 0, 255]),
+        (96, [0, 0, 255, 255]),
+        (160, [255, 0, 0, 255]),
+        (224, [0, 0, 255, 255]),
+    ] {
+        assert_eq!(
+            &wrapped[x * 4..x * 4 + 4],
+            &pixel,
+            "explicit Repeat wrapping must survive Nearest override"
+        );
+    }
+    // Render shared images repeatedly in opposite order; no sampler leak.
+    for _ in 0..3 {
+        record(
+            smooth,
+            vec![DrawCommand::NoStroke, draw_image(image, 256., 256.)],
+        )?;
+        assert_eq!(read(smooth, "image-linear-repeat", &out)?, linear);
+        record(
+            off,
+            vec![DrawCommand::NoStroke, draw_image(image, 256., 256.)],
+        )?;
+        assert_eq!(read(off, "image-nearest-repeat", &out)?, nearest);
+    }
+    let edge = || {
+        vec![
+            DrawCommand::BackgroundColor(Color::BLACK),
+            DrawCommand::NoStroke,
+            DrawCommand::Fill(Color::WHITE),
+            DrawCommand::Triangle {
+                x1: 11.3,
+                y1: 12.3,
+                x2: 118.3,
+                y2: 47.3,
+                x3: 25.3,
+                y3: 109.3,
+            },
+            DrawCommand::Ellipse {
+                cx: 170.3,
+                cy: 170.3,
+                w: 95.7,
+                h: 95.7,
+            },
+            DrawCommand::StrokeColor(Color::WHITE),
+            DrawCommand::StrokeWeight(3.7),
+            DrawCommand::Line {
+                x1: 9.3,
+                y1: 135.3,
+                x2: 99.3,
+                y2: 229.3,
+            },
+        ]
+    };
+    record(smooth, edge())?;
+    record(off, edge())?;
+    assert!(!binary(&read(smooth, "edges-default", &out)?));
+    assert!(
+        binary(&read(off, "edges-off", &out)?),
+        "off shape edges must be binary"
+    );
+    let text = || {
+        vec![
+            DrawCommand::BackgroundColor(Color::BLACK),
+            DrawCommand::NoStroke,
+            DrawCommand::Fill(Color::WHITE),
+            DrawCommand::TextSize(49.7),
+            DrawCommand::Text {
+                content: "Outline Aa 123".into(),
+                x: 7.3,
+                y: 77.3,
+                z: 0.,
+                max_w: Some(240.),
+                max_h: None,
+            },
+        ]
+    };
+    record(smooth, text())?;
+    record(off, text())?;
+    assert!(!binary(&read(smooth, "text-default", &out)?));
+    let text_off = read(off, "text-off", &out)?;
+    assert!(binary(&text_off));
+    assert!(
+        text_off.chunks_exact(4).any(|p| p == [255, 255, 255, 255]),
+        "text must actually render"
+    );
+    // Copy Graphics -> image -> Graphics; existing blitter is Nearest.
+    let (_, small) = make(2, 1, 1)?;
+    record(
+        small,
+        vec![DrawCommand::NoStroke, draw_image(image, 2., 1.)],
+    )?;
+    let intermediary = image_create(
+        Extent3d {
+            width: 2,
+            height: 1,
+            depth_or_array_layers: 1,
+        },
+        vec![0; 8],
+        TextureFormat::Rgba8UnormSrgb,
+    )?;
+    image_copy_from(intermediary, small, true)?;
+    record(
+        off,
+        vec![DrawCommand::NoStroke, draw_image(intermediary, 256., 256.)],
+    )?;
+    assert_eq!(read(off, "graphics-composite", &out)?, nearest);
+    graphics_record_command(off, DrawCommand::BackgroundColor(Color::srgb(0., 1., 0.)))?;
+    assert_eq!(
+        graphics_readback_completed_raw(off)?.bytes,
+        nearest,
+        "completed readback must not execute new commands"
+    );
+    assert!(
+        graphics_readback_raw(off)?
+            .bytes
+            .chunks_exact(4)
+            .all(|p| p == [0, 255, 0, 255])
+    );
+    // Original image alpha is retained, not thresholded to opaque/transparent.
+    let alpha_image = image_create(
+        Extent3d {
+            width: 2,
+            height: 1,
+            depth_or_array_layers: 1,
+        },
+        vec![255, 255, 255, 64, 255, 255, 255, 192],
+        TextureFormat::Rgba8UnormSrgb,
+    )?;
+    record(
+        off,
+        vec![
+            DrawCommand::BackgroundColor(Color::NONE),
+            DrawCommand::NoStroke,
+            draw_image(alpha_image, 256., 256.),
+        ],
+    )?;
+    let alpha = read(off, "image-alpha", &out)?;
+    assert_eq!(alpha[(128 * 256 + 32) * 4 + 3], 64);
+    assert_eq!(alpha[(128 * 256 + 224) * 4 + 3], 192);
+    record(
+        off,
+        vec![
+            DrawCommand::BackgroundColor(Color::NONE),
+            DrawCommand::NoStroke,
+            DrawCommand::Fill(Color::srgba(1., 1., 1., 0.5)),
+            DrawCommand::Rect {
+                x: 32.,
+                y: 32.,
+                w: 128.,
+                h: 128.,
+                radii: [0.; 4],
+            },
+        ],
+    )?;
+    let opacity = read(off, "fill-alpha", &out)?;
+    assert!((opacity[(64 * 256 + 64) * 4 + 3] as i16 - 128).abs() <= 1);
+    processing_core::app_mut(|app| processing_render::graphics::warmup(app, off))?;
+    assert!(
+        graphics_no_smooth(off).is_err(),
+        "a later warmup must not unlock settings"
+    );
+    // Invalid values and entities return typed errors, including C parse values.
+    assert!(Antialiasing::try_from(255).is_err());
+    assert!(ImageSampling::try_from(255).is_err());
+    let (_, pending) = make(16, 16, 0)?;
+    graphics_record_command(pending, DrawCommand::BackgroundColor(Color::BLACK))?;
+    assert!(
+        graphics_no_smooth(pending).is_err(),
+        "queued commands lock configuration"
+    );
+    processing_core::app_mut(|app| {
+        assert_eq!(app.world().get::<Msaa>(off).unwrap().samples(), 1);
+        assert_eq!(app.world().get::<Msaa>(smooth).unwrap().samples(), 4);
+        Ok(())
+    })?;
+    graphics_destroy(pending)?;
+    assert!(graphics_no_smooth(pending).is_err());
+    let gpu_count = || {
+        processing_core::app_mut(|app| {
+            Ok(app.sub_app(bevy::render::RenderApp).world().resource::<bevy::render::render_asset::RenderAssets<bevy::render::texture::GpuImage>>().iter().count())
+        })
+    };
+    let before = gpu_count()?;
+    for mode in [1, 0, 1, 0, 1, 0] {
+        let (s, g) = make(256, 256, mode)?;
+        record(
+            g,
+            vec![DrawCommand::NoStroke, draw_image(image, 256., 256.)],
+        )?;
+        assert_eq!(
+            read(g, "lifecycle", &out)?,
+            if mode == 1 {
+                nearest.clone()
+            } else {
+                linear.clone()
+            }
+        );
+        graphics_destroy(g)?;
+        surface_destroy(s)?;
+    }
+    processing_core::app_mut(|app| {
+        for _ in 0..4 {
+            app.update();
+        }
+        Ok(())
+    })?;
+    assert!(
+        gpu_count()? <= before,
+        "destroy/recreate must release GPU image aliases"
+    );
+    fs::write(
+        format!("{out}/passed.txt"),
+        "GPU image semantics, AA, text, alpha, isolation, composition, lifecycle: passed\n",
+    )
+    .unwrap();
+    println!("All native GPU image checks passed");
+    exit(0)?;
+    Ok(())
+}
diff --git a/examples/smooth_probe.rs b/examples/smooth_probe.rs
new file mode 100644
index 0000000..bcb6ee7
--- /dev/null
+++ b/examples/smooth_probe.rs
@@ -0,0 +1,146 @@
+//! Offscreen CPU-readback baseline, no window or MIDI device required.
+use bevy::{prelude::*, render::render_resource::Extent3d};
+use processing::prelude::*;
+use std::{fs, time::Instant};
+
+fn main() -> error::Result<()> {
+    let args: Vec<String> = std::env::args().collect();
+    let w: u32 = args.get(1).and_then(|v| v.parse().ok()).unwrap_or(256);
+    let h: u32 = args.get(2).and_then(|v| v.parse().ok()).unwrap_or(256);
+    let scene = args.get(3).map(String::as_str).unwrap_or("shapes");
+    let out = args.get(4).map(String::as_str).unwrap_or("probe");
+    let count: usize = args.get(5).and_then(|v| v.parse().ok()).unwrap_or(60);
+    let mode = args.get(6).map(String::as_str).unwrap_or("default");
+    let start = Instant::now();
+    init(Config::default())?;
+    let init_ms = start.elapsed().as_secs_f64() * 1000.;
+    let create_at = Instant::now();
+    let surface = surface_create_offscreen(w, h, 1., TextureFormat::Rgba8UnormSrgb)?;
+    let g = graphics_create(surface, w, h, TextureFormat::Rgba8UnormSrgb)?;
+    if mode == "no-smooth" {
+        graphics_no_smooth(g)?;
+    }
+    let create_ms = create_at.elapsed().as_secs_f64() * 1000.;
+    processing_core::app_mut(|app| {
+        println!(
+            "effective_msaa={:?}",
+            app.world().get::<bevy::render::view::Msaa>(g)
+        );
+        Ok(())
+    })?;
+    let image = image_create(
+        Extent3d {
+            width: 2,
+            height: 1,
+            depth_or_array_layers: 1,
+        },
+        vec![255, 0, 0, 255, 0, 0, 255, 255],
+        TextureFormat::Rgba8UnormSrgb,
+    )?;
+    let mut times = Vec::new();
+    let mut stages = Vec::new();
+    let mut last = Vec::new();
+    let mut first_frame_ms = 0.;
+    for frame in 0..count + 10 {
+        if frame == 10 {
+            println!("BENCH_START");
+        }
+        let t = Instant::now();
+        graphics_begin_draw(g)?;
+        graphics_record_command(g, DrawCommand::BackgroundColor(Color::BLACK))?;
+        graphics_record_command(g, DrawCommand::NoStroke)?;
+        graphics_record_command(g, DrawCommand::Fill(Color::WHITE))?;
+        match scene {
+            "image" => graphics_record_command(
+                g,
+                DrawCommand::Image {
+                    entity: image,
+                    dx: 0.,
+                    dy: 0.,
+                    d_width: Some(w as f32),
+                    d_height: Some(h as f32),
+                    sx: None,
+                    sy: None,
+                    s_width: None,
+                    s_height: None,
+                },
+            )?,
+            "text" => {
+                graphics_record_command(g, DrawCommand::TextSize(24.))?;
+                for i in 0..100 {
+                    graphics_record_command(
+                        g,
+                        DrawCommand::Text {
+                            content: "Processing 0123 Aa".into(),
+                            x: (i % 5) as f32 * w as f32 / 5.,
+                            y: (i / 5 + 1) as f32 * h as f32 / 21.,
+                            z: 0.,
+                            max_w: None,
+                            max_h: None,
+                        },
+                    )?;
+                }
+            }
+            _ => {
+                for i in 0..1000 {
+                    let x = ((i * 37) % w) as f32 + 0.3;
+                    let y = ((i * 71) % h) as f32 + 0.3;
+                    graphics_record_command(
+                        g,
+                        DrawCommand::Triangle {
+                            x1: x,
+                            y1: y,
+                            x2: x + 19.,
+                            y2: y + 5.,
+                            x3: x + 3.,
+                            y3: y + 23.,
+                        },
+                    )?;
+                    graphics_record_command(
+                        g,
+                        DrawCommand::Ellipse {
+                            cx: x + 31.,
+                            cy: y + 31.,
+                            w: 19.,
+                            h: 19.,
+                        },
+                    )?;
+                }
+            }
+        }
+        let generated = t.elapsed().as_secs_f64() * 1000.;
+        let submitted_at = Instant::now();
+        graphics_flush(g)?;
+        let submitted = submitted_at.elapsed().as_secs_f64() * 1000.;
+        let read_at = Instant::now();
+        let raw = graphics_readback_completed_raw(g)?;
+        let read_ms = read_at.elapsed().as_secs_f64() * 1000.;
+        let elapsed = t.elapsed().as_secs_f64() * 1000.;
+        if frame == 0 {
+            first_frame_ms = elapsed;
+        }
+        if frame >= 10 {
+            times.push(elapsed);
+            stages.push((frame, generated, submitted, read_ms, elapsed));
+        }
+        last = raw.bytes;
+    }
+    println!("BENCH_END");
+    fs::write(format!("{out}.rgba"), last).unwrap();
+    times.sort_by(f64::total_cmp);
+    let median = times[times.len() / 2];
+    let p95 = times[((times.len() as f64 * 0.95).ceil() as usize - 1).min(times.len() - 1)];
+    fs::write(format!("{out}.csv"), format!("width,height,scene,samples,init_ms,graphics_create_ms,first_frame_ms,median_total_readback_ms,p95_total_readback_ms\n{w},{h},{scene},{count},{init_ms},{create_ms},{first_frame_ms},{median},{p95}\n")).unwrap();
+    let mut rows = String::from(
+        "frame,command_generation_ms,cpu_tessellation_and_submit_ms,readback_including_gpu_wait_ms,total_ms\n",
+    );
+    for (frame, c, s, r, t) in stages {
+        rows.push_str(&format!("{frame},{c},{s},{r},{t}\n"));
+    }
+    fs::write(format!("{out}-stages.csv"), rows).unwrap();
+    println!("{scene} {w}x{h}: median={median:.3}ms p95={p95:.3}ms init={init_ms:.3}ms");
+    graphics_destroy(g)?;
+    surface_destroy(surface)?;
+    exit(0)?;
+    Ok(())
+}
