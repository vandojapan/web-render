new file mode 100644
index 0000000..b5aac50
--- /dev/null
+++ b/crates/processing_render/src/smoothing.rs
@@ -0,0 +1,243 @@
+//! Initial, per-Graphics rasterization and image-sampling configuration.
+//! GPU image aliases share the source texture and only replace its sampler.
+use crate::render::material::ProcessingExtendedMaterial;
+use bevy::{
+    asset::{AssetId, RenderAssetUsages},
+    core_pipeline::tonemapping::DebandDither,
+    image::{ImageSampler, ImageSamplerDescriptor},
+    prelude::*,
+    render::{
+        Render, RenderApp, RenderSystems,
+        erased_render_asset::prepare_erased_assets,
+        extract_component::{ExtractComponent, ExtractComponentPlugin},
+        render_asset::{RenderAssets, prepare_assets},
+        render_resource::{DefaultImageSamplerDescriptor, Sampler},
+        renderer::RenderDevice,
+        texture::GpuImage,
+        view::Msaa,
+    },
+};
+use processing_core::error::{ProcessingError, Result};
+use std::collections::{HashMap, HashSet};
+
+/// Effective multisampling. Off means one sample; Default retains Bevy's four.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+#[repr(u8)]
+pub enum Antialiasing {
+    #[default]
+    Default = 0,
+    Off = 1,
+}
+impl TryFrom<u8> for Antialiasing {
+    type Error = ProcessingError;
+    fn try_from(v: u8) -> Result<Self> {
+        match v {
+            0 => Ok(Self::Default),
+            1 => Ok(Self::Off),
+            _ => Err(ProcessingError::InvalidArgument(format!(
+                "unknown antialiasing: {v}"
+            ))),
+        }
+    }
+}
+/// Default inherits the individual image sampler. Explicit Graphics settings
+/// override its filters, retaining addressing and other sampler properties.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+#[repr(u8)]
+pub enum ImageSampling {
+    #[default]
+    Default = 0,
+    Linear = 1,
+    Nearest = 2,
+}
+impl TryFrom<u8> for ImageSampling {
+    type Error = ProcessingError;
+    fn try_from(v: u8) -> Result<Self> {
+        match v {
+            0 => Ok(Self::Default),
+            1 => Ok(Self::Linear),
+            2 => Ok(Self::Nearest),
+            _ => Err(ProcessingError::InvalidArgument(format!(
+                "unknown image sampling: {v}"
+            ))),
+        }
+    }
+}
+
+#[derive(Clone)]
+struct Alias {
+    source: Handle<Image>,
+    handle: Handle<Image>,
+    descriptor: ImageSamplerDescriptor,
+}
+
+#[derive(Component, Clone, Default, ExtractComponent)]
+#[doc(hidden)]
+pub struct Smoothing {
+    pub(crate) aa: Antialiasing,
+    pub(crate) sampling: ImageSampling,
+    pub(crate) started: bool,
+    original_dither: Option<DebandDither>,
+    aliases: HashMap<AssetId<Image>, Alias>,
+}
+impl Smoothing {
+    fn configurable(&self) -> Result<()> {
+        if self.started {
+            Err(ProcessingError::InvalidArgument(
+                "smoothing must be configured before the first begin_draw or recorded command"
+                    .into(),
+            ))
+        } else {
+            Ok(())
+        }
+    }
+    pub fn image_handle(
+        &mut self,
+        source: &Handle<Image>,
+        images: &mut Assets<Image>,
+        default: &ImageSamplerDescriptor,
+    ) -> Handle<Image> {
+        if self.sampling == ImageSampling::Default {
+            return source.clone();
+        }
+        let Some(image) = images.get(source) else {
+            return source.clone();
+        };
+        let mut descriptor = match &image.sampler {
+            ImageSampler::Default => default.clone(),
+            ImageSampler::Descriptor(d) => d.clone(),
+        };
+        // Reuse precisely the same filter conversion as image_set_sampler.
+        crate::image::set_sampler_filters(
+            &mut descriptor,
+            if self.sampling == ImageSampling::Nearest {
+                1
+            } else {
+                0
+            },
+        )
+        .expect("typed sampling mode");
+        if let Some(alias) = self.aliases.get(&source.id()) {
+            if alias.descriptor == descriptor {
+                return alias.handle.clone();
+            }
+        }
+        // This is an asset identity, not a second upload or full-size texture.
+        let mut placeholder = Image::default();
+        placeholder.asset_usage = RenderAssetUsages::MAIN_WORLD;
+        let handle = images.add(placeholder);
+        self.aliases.insert(
+            source.id(),
+            Alias {
+                source: source.clone(),
+                handle: handle.clone(),
+                descriptor,
+            },
+        );
+        handle
+    }
+}
+
+pub struct SmoothingPlugin;
+#[derive(Resource)]
+pub(crate) struct SamplingDefaults(pub ImageSamplerDescriptor);
+impl Plugin for SmoothingPlugin {
+    fn build(&self, app: &mut App) {
+        app.add_plugins(ExtractComponentPlugin::<Smoothing>::default());
+        if let Some(render) = app.get_sub_app_mut(RenderApp) {
+            render.init_resource::<AliasSamplers>().add_systems(
+                Render,
+                prepare_aliases
+                    .in_set(RenderSystems::PrepareAssets)
+                    .after(prepare_assets::<GpuImage>)
+                    .before(prepare_erased_assets::<MeshMaterial3d<ProcessingExtendedMaterial>>),
+            );
+        }
+        app.insert_resource(SamplingDefaults(ImageSamplerDescriptor::linear()));
+    }
+    fn finish(&self, app: &mut App) {
+        // TexturePlugin initializes this descriptor during its finish phase.
+        if let Some(render) = app.get_sub_app(RenderApp) {
+            if let Some(defaults) = render
+                .world()
+                .get_resource::<DefaultImageSamplerDescriptor>()
+            {
+                let defaults = defaults.0.clone();
+                app.insert_resource(SamplingDefaults(defaults));
+            }
+        }
+    }
+}
+
+#[derive(Resource, Default)]
+struct AliasSamplers(HashMap<AssetId<Image>, Sampler>);
+fn prepare_aliases(
+    states: Query<&Smoothing>,
+    device: Res<RenderDevice>,
+    mut gpu: ResMut<RenderAssets<GpuImage>>,
+    mut cache: ResMut<AliasSamplers>,
+) {
+    let mut live = HashSet::new();
+    for state in &states {
+        for alias in state.aliases.values() {
+            live.insert(alias.handle.id());
+            let Some(mut image) = gpu.get(alias.source.id()).cloned() else {
+                continue;
+            };
+            image.sampler = cache
+                .0
+                .entry(alias.handle.id())
+                .or_insert_with(|| device.create_sampler(&alias.descriptor.as_wgpu()))
+                .clone();
+            gpu.insert(alias.handle.id(), image);
+        }
+    }
+    cache.0.retain(|id, _| {
+        if live.contains(id) {
+            true
+        } else {
+            gpu.remove(*id);
+            false
+        }
+    });
+}
+
+/// Atomic validation precedes either change, so noSmooth cannot partly apply.
+pub(crate) fn configure(
+    app: &mut App,
+    entity: Entity,
+    aa: Option<Antialiasing>,
+    sampling: Option<ImageSampling>,
+) -> Result<()> {
+    let state = app
+        .world()
+        .get::<Smoothing>(entity)
+        .ok_or(ProcessingError::GraphicsNotFound)?;
+    state.configurable()?;
+    let mut entity = app.world_mut().entity_mut(entity);
+    if let Some(aa) = aa {
+        entity.insert(match aa {
+            Antialiasing::Default => Msaa::default(),
+            Antialiasing::Off => Msaa::Off,
+        });
+        entity.get_mut::<Smoothing>().unwrap().aa = aa;
+    }
+    if let Some(sampling) = sampling {
+        entity.get_mut::<Smoothing>().unwrap().sampling = sampling;
+    }
+    let previous_dither = entity
+        .get::<DebandDither>()
+        .copied()
+        .unwrap_or(DebandDither::Disabled);
+    let dither = {
+        let mut state = entity.get_mut::<Smoothing>().unwrap();
+        let original = *state.original_dither.get_or_insert(previous_dither);
+        if state.aa == Antialiasing::Off || state.sampling == ImageSampling::Nearest {
+            DebandDither::Disabled
+        } else {
+            original
+        }
+    };
+    entity.insert(dither);
+    Ok(())
+}
